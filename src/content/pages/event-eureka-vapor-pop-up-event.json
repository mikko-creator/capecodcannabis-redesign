    },
    {
     "t": "image",
     "ref": "assets/source/af36f482-eureka-logo.png",
     "srcUrl": "https://b2702268.assetcdn.net/2.0/2702268/wp-content/uploads/2026/06/eureka-logo.png?lossy=2&strip=0&webp=1",
     "alt": "Eureka Vapor at Cape Cod Cannabis in Wellfleet.",
     "w": 442,
