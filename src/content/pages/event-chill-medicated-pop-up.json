    {
     "t": "image",
     "ref": "assets/source/ffaab36e-Chill-200px-2.png",
     "srcUrl": "https://b2702268.assetcdn.net/2.0/2702268/wp-content/uploads/2023/07/Chill-200px-2.png?lossy=2&strip=0&webp=1",
