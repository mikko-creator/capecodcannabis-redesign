    {
     "t": "heading",
     "level": 4,
     "text": "Cannabis-Infused Edibles for Every Adventure"
    },
    {
     "t": "rich",
     "html": "<p><strong>Learn more about WYLD Brand cannabis sativa, indica, hybrid or CBD edibles and their many delicious flavors!</strong></p>"
    },
    {
     "t": "image",
     "ref": null,
     "srcUrl": "https://images.dutchie.com/6e94741db1951132b85408abff06e0eb",
     "missing": "not-inventoried",
     "alt": "Gummies | Wyld | Strawberry | 1:20 THC:CBD | 10pk/20serv image 0",
     "titleAttr": "Cape Cod Cannabis Recreational Dispensary in Wellfleet, MA",
     "w": 310,
