   "blocks": [
    {
     "t": "heading",
     "level": 1,
     "text": "How Much Cannabis Should You Use?",
     "demote": true
    },
    {
     "t": "rich",
     "html": "<p>Dosing depends on your experience level and the product type.</p><p>• Start low<br>• Increase slowly<br>• Follow product labeling<br>• Ask our Product Specialists for guidance</p><p>Beginners especially should proceed slowly with edibles. </p>"
    }
   ]
  },
