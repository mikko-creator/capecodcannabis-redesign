    "desktop",
    "tablet"
   ],
   "blocks": [
    {
     "t": "rich",
     "html": "<p><strong><em>Looking for cannabis flower on Cape Cod?</em> </strong>Cape Cod Cannabis in Wellfleet offers one of Cape Cod’s largest selections of high-quality cannabis flower, including premium whole flower, small buds, infused flower, pre-ground flower, and more from trusted Massachusetts cultivators.</p><p>Whether you’re searching for <a href=\"/categories/flower/?category=flower&amp;strain=indica\">relaxing indicas</a>, <a href=\"/categories/flower/?category=flower&amp;strain=sativa\">uplifting sativas</a>, <a href=\"/categories/flower/?category=flower&amp;strain=hybrid\">balanced hybrids</a>, or terpene-rich strains, our knowledgeable team can help you find the right flower for your preferences and experience level. Browse our live online menu below, pre-order your favorites, and pick them up at our <a href=\"/directions/\">convenient Route 6 location in the South Wellfleet shopping plaza</a>. <strong><em>Serving Cape Cod residents and visitors since 2021.</em></strong></p>",
     "dev": [
      "widescreen",
      "desktop",
      "tablet"
     ]
    }
   ]
  },
  {
   "n": 4,
