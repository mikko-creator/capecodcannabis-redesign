   "blocks": [
    {
     "t": "rich",
     "html": "<p><em>Explore top-quality cannabis flower at Cape Cod Cannabis in Wellfleet.</em> Whether you’re searching for high-THC strains, balanced hybrids, or terpene-rich sativas, our curated selection of premium buds is grown and tested in Massachusetts. Perfect for locals and Cape visitors alike, our flower menu includes classic favorites and new drops from trusted brands.</p>",
     "dev": [],
     "hiddenAll": true
    }
   ]
