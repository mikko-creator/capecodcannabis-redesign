    {
     "t": "image",
     "ref": "assets/source/104bec1a-perpetual_logo_200px.png",
     "srcUrl": "https://b2702268.assetcdn.net/2.0/2702268/wp-content/uploads/2024/09/perpetual_logo_200px.png?lossy=2&strip=0&webp=1",
     "alt": "",
