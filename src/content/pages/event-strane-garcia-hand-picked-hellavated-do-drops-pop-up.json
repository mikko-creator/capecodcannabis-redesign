    },
    {
     "t": "image",
     "ref": "assets/source/e4f8eca8-strane_logo_200px.jpg",
     "srcUrl": "https://b2702268.assetcdn.net/2.0/2702268/wp-content/uploads/2024/03/strane_logo_200px.jpg?lossy=2&strip=0&webp=1",
     "alt": "",
